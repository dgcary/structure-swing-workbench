# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
POSTGRES_DB=structure_swing
POSTGRES_USER=structure_swing
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://structure_swing:change-me@postgres:5432/structure_swing

# Market data
MARKET_DATA_PROVIDER=akshare

# Research integration
RESEARCH_ADAPTER=stockresearchpack
RESEARCH_BASE_URL=

# LLM adapter (optional; never commit real credentials)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# M8: persisted projection is read-only by default.
WORKBENCH_PERSISTED_READ_ENABLED=false
# Opt-in manual date-only edits for existing PLANNED actions (never order execution).
# Only enable behind HTTPS; use a random 32+ character secret, never commit it.
WORKBENCH_ACTION_DATE_WRITE_ENABLED=false
WORKBENCH_ACTION_DATE_WRITE_TOKEN=
