# Copy to .env.home on the Ubuntu/NAS host. Use a stable private IPv4 address.
HOME_LAN_IP=192.168.1.10
# Generate 32+ random ASCII characters, preferably hexadecimal. Never commit real values.
HOME_DB_PASSWORD=
# Internal proxy-to-backend secret; users do not enter this in the browser.
HOME_JOURNAL_TOKEN=
# Caddy bcrypt hash for the whole-site login. Single quotes preserve dollar signs.
HOME_PASSWORD_HASH=''
